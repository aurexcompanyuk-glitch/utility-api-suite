# Copy to .env and fill in. NEVER commit the real .env file.
#
# BestTime.app credentials — https://besttime.app/
# The PRIVATE key must stay server-side. It is never sent to browsers
# and never included in an API response.
BESTTIME_API_KEY_PRIVATE=pri_your_private_key_here
BESTTIME_API_KEY_PUBLIC=pub_your_public_key_here

# Optional: restrict venue queries to one BestTime collection.
# BESTTIME_COLLECTION_ID=

# Optional overrides
# BESTTIME_BASE_URL=https://besttime.app/api/v1
# BESTTIME_TIMEOUT=20

# Cache TTLs in seconds. BestTime bills per request, so raising these
# lowers cost; lowering them makes live data fresher.
# LIVE_CACHE_TTL=300
# FORECAST_CACHE_TTL=86400

# Serve simulated data when BestTime is unreachable. Set to false in
# production if you would rather surface an error than fake numbers.
# ALLOW_SIMULATED_FALLBACK=true
